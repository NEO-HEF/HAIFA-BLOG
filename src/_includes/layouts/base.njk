<!doctype html>
{% set currentLang = lang or "cs" %}
<html lang="{{ currentLang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} | {% endif %}{{ "siteTitle" | t(currentLang) }}</title>
    <meta name="description" content="{% if summary %}{{ summary }}{% else %}{{ "siteDescription" | t(currentLang) }}{% endif %}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ '/assets/site.css' | url }}">
    <script data-goatcounter="https://janbkrejci.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="{% if page.url == ('/' | url) or page.url == ('/en/' | url) %}page-home{% else %}page-post{% endif %}">
    <div class="page-shell">
      <header class="site-header">
        <div class="site-header-inner">
          <a class="site-brand" href="{{ currentLang | homeUrl | url }}">{{ "siteTitle" | t(currentLang) }}</a>
          <p class="site-tagline">{{ "siteSubtitle" | t(currentLang) }}</p>
          <nav class="language-switch" aria-label="{{ "switchLabel" | t(currentLang) }}">
            {% if currentLang == "en" %}
            <a href="{{ '/' | url }}">Česky</a>
            <span>English</span>
            {% else %}
            <span>Česky</span>
            <a href="{{ '/en/' | url }}">English</a>
            {% endif %}
          </nav>
        </div>
      </header>

      <main class="site-main">
        {{ content | safe }}
      </main>

      <footer class="site-footer">
        <p>
          {% if currentLang == "en" %}Blog author{% else %}Autor blogu{% endif %}:
          <a href="mailto:jan.krejci@assecosol.com">jan.krejci@assecosol.com</a>
        </p>
      </footer>
    </div>
  </body>
</html>
