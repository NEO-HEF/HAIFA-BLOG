---
layout: layouts/base.njk
title: All Articles
lang: en
permalink: /en/
---
<section class="post-list">
  {% set currentLang = lang or "en" %}
  {% set posts = collections.post | postsByLang(currentLang) | reverse %}
  {% for post in posts %}
  <article class="post-card">
    <p class="post-card-meta">
      <span>{{ post.date | humanDate(currentLang) }}</span>
      {% if post.data.period %}
      <span>{{ post.data.period }}</span>
      {% endif %}
    </p>
    <h3><a href="{{ post.url | url }}">{{ post.data.title }}</a></h3>
    {% if post.data.summary %}
    <p>{{ post.data.summary }}</p>
    {% endif %}
  </article>
  {% endfor %}
</section>
