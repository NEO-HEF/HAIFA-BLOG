---
layout: layouts/base.njk
title: Přehled článků
---
<section class="post-list">
  {% set posts = collections.post | reverse %}
  {% for post in posts %}
  <article class="post-card">
    <p class="post-card-meta">
      <span>{{ post.date | humanDate }}</span>
      {% if post.data.period %}
      <span>{{ post.data.period }}</span>
      {% endif %}
    </p>
    <h3><a href="{{ post.url | url }}">{{ post.data.title }}</a></h3>
    {% if post.data.summary %}
    <p>{{ post.data.summary }}</p>
    {% endif %}
  </article>
  {% endfor %}
</section>
